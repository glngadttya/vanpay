# ============ VANPAY GATEWAY ============
# Salin ke .env lalu isi. Semua wajib kecuali ditandai opsional.

# Server
PORT=3000
# URL publik (untuk redirect OAuth & link QR). WAJIB diisi.
PUBLIC_URL=http://localhost:3000

# ----- QRIS utama (punya owner, merchant GoBiz) -----
# String EMVCo dari scan QRIS statis GoBiz lu (dimulai "000201..."), bukan URL.
QRIS_STRING=

# ----- Login GoBiz / GoPay Merchant -----
# Login lewat `node login.js` (nomor HP + OTP) - cara paling gampang.
# Alternatif: isi email+password dibawah untuk dipakai login.js mode password.
GOPAY_COUNTRY_CODE=+62
GOPAY_PHONE=
GOPAY_EMAIL=
GOPAY_PASSWORD=

# ----- Fee (standar nasional, dibayar pembeli) -----
# Persen fee atas nominal QRIS. Rp 5.000 + 0,7% = pembeli bayar 5.035.
FEE_PCT=0.7
MIN_FEE=0
MIN_QRIS_AMOUNT=1000
MAX_QRIS_AMOUNT=100000000

# ----- Penarikan -----
MIN_WITHDRAW=5000
MAX_WITHDRAW=50000000

# ----- OAuth login web -----
# Buat di https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Buat di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Akun dengan email ini otomatis jadi owner (dashboard owner).
OWNER_EMAIL=

# ----- Notifikasi Telegram -----
# Token dari @BotFather, chat id dari @userinfobot / @getidsbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Polling & keamanan -----
# Jarak minimum antar polling (detik x1000). Jangan < 7000 biar akun ga strike.
POLL_MIN_INTERVAL_MS=7000
# Secret untuk panggil /api/cron/poll (dipakai cron Vercel / webhook luar).
POLL_SECRET=
# Ganti dari default!
WEBHOOK_SECRET=ubah-ini-panjang-keras
SESSION_TTL_DAYS=7

# ----- Database -----
# Lokal: SQLite (default). Untuk Vercel/Postgres: isi DATABASE_URL (Neon/Supabase).
# DATABASE_URL=postgres://user:pass@host/db
DB_FILE=data/vanpay.db

# Kredensial GoBiz via token langsung (opsional, diisi dari `node login.js`)
# GOPAY_ACCESS_TOKEN=

# ---- Opsional tuning endpoint GoBiz (kalau API merchant berubah) ----
# GOBIZ_HOST=https://blockchain.gobiz.co.id
# GOBIZ_APP_VERSION=5.7.0
# GOBIZ_APP_ID=co.gobiz.flutter
# GOBIZ_DEVICE_ID=