# ============ VANPAY GATEWAY ============
# Semua setelan JUGA bisa diatur lewat web (Dashboard -> Pengaturan, login owner
# melalui link /bootstrap/<token> yang dicetak log saat boot pertama). File .env ini
# HANYA fallback / nilai awal. Opsional, hampir semuanya boleh dikosongkan.

# Server
PORT=3000

# ----- QRIS utama (punya owner, merchant GoBiz) -----
# Fallback saja; yang utama diatur di Dashboard (Pengaturan -> QRIS utama & mode).
QRIS_STRING=

# ----- Login GoBiz / GoPay Merchant -----
# Sepenuhnya lewat web sekarang: Dashboard > Pengaturan > Login GoBiz (OTP/password).
GOPAY_COUNTRY_CODE=+62
GOPAY_PHONE=
GOPAY_EMAIL=
GOPAY_PASSWORD=

# ----- Fee & limit (bisa diubah di Dashboard > Pengaturan > Biaya & limit) -----
FEE_PCT=0.7
MIN_FEE=0
MIN_QRIS_AMOUNT=1000
MAX_QRIS_AMOUNT=100000000
MIN_WITHDRAW=5000
MAX_WITHDRAW=50000000

# ----- OAuth login web (fallback; atur di Dashboard > Pengaturan > Login web) -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=

# ----- Notifikasi Telegram (fallback; atur di Dashboard > Pengaturan) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Polling & keamanan -----
# Jarak minimum antar polling (detik x1000). Jangan < 7000 agar akun tidak di-limit.
POLL_MIN_INTERVAL_MS=7000
# Secret untuk panggil /api/cron/poll (dipakai cron Vercel / webhook luar).
POLL_SECRET=
SESSION_TTL_DAYS=7

# ----- Database -----
# Lokal: SQLite (default). Untuk Vercel/Postgres: isi DATABASE_URL (Neon/Supabase).
# DATABASE_URL=postgres://user:pass@host/db
DB_FILE=data/vanpay.db

# ---- Opsional tuning endpoint GoBiz (kalau API merchant berubah) ----
# GOBIZ_HOST=https://blockchain.gobiz.co.id
# GOBIZ_APP_VERSION=5.7.0
# GOBIZ_APP_ID=co.gobiz.flutter
# GOBIZ_DEVICE_ID=