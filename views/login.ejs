<!doctype html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Masuk — VanPay Gateway' }) %>
</head>
<body>
  <%- include('partials/menu', { body: include('partials/pubnav', { navNow: 'login' }), foot: '' }) %>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Masuk ke VanPay</h1>
      <p class="sub">Gunakan akun Google atau GitHub Anda. Akun baru akan dibuat secara otomatis.</p>
      <div class="oauth">
        <a class="btn" href="/auth/google">
          <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Masuk dengan Google
        </a>
        <a class="btn" href="/auth/github">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.04c-3.2.7-3.87-1.35-3.87-1.35-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.96 10.96 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          Masuk dengan GitHub
        </a>
      </div>
      <% if (loginErr) { %>
        <div class="msg err" id="msg"><%= esc(loginErr) %></div>
      <% } %>
      <div class="note">
        <i class="fa-solid fa-circle-info"></i>&nbsp;Login pertama kali untuk pemilik (owner): buka tautan <b>/bootstrap/&lt;token&gt;</b> yang tercetak pada log server saat proses boot. Setelah menjadi owner, seluruh pengaturan (QRIS, GoBiz, Telegram, OAuth) dapat dikelola melalui dashboard → <b><i class="fa-solid fa-gear"></i> Pengaturan</b>.
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>