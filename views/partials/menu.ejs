<div class="float-nav">
  <button class="back" id="btnBack" aria-label="Kembali" title="Kembali"><i class="fa-solid fa-arrow-left"></i><span id="btnBackLabel">kembali</span></button>
  <button class="fab" id="btnMenu" aria-label="Menu" title="Menu"><i class="fa-solid fa-bars"></i></button>
</div>

<div class="scrim" id="scrim"></div>
<nav class="drawer" id="drawer" aria-label="Menu navigasi">
  <div class="drawer-top">
    <b class="drawer-title">Menu</b>
    <button class="fab fab-x" id="btnClose" aria-label="Tutup" title="Tutup"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="drawer-body"><%- body %></div>
  <% if (foot && foot.length) { %>
    <div class="drawer-foot"><%- foot %></div>
  <% } %>
</nav>
<script>
(function () {
  'use strict';
  var drawer = document.getElementById('drawer');
  var scrim = document.getElementById('scrim');
  function open() { if (!drawer) return; drawer.classList.add('open'); if (scrim) scrim.classList.add('on'); document.body.style.overflow = 'hidden'; }
  function close() { if (drawer) drawer.classList.remove('open'); if (scrim) scrim.classList.remove('on'); document.body.style.overflow = ''; }
  var bMenu = document.getElementById('btnMenu');
  var bClose = document.getElementById('btnClose');
  var bBack = document.getElementById('btnBack');
  var bLabel = document.getElementById('btnBackLabel');
  if (bMenu && drawer) bMenu.addEventListener('click', open);
  if (bClose && drawer) bClose.addEventListener('click', close);
  if (scrim) scrim.addEventListener('click', close);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  if (bBack) {
    function labelFor(p) {
      if (p === '/') return 'kembali ke Beranda';
      if (p === '/cara-kerja') return 'kembali ke Cara Kerja';
      if (p === '/docs') return 'kembali ke Dokumentasi API';
      if (p === '/login') return 'kembali ke halaman Masuk';
      if (p.indexOf('/dashboard') === 0) return 'kembali ke Dashboard';
      return 'kembali ke halaman sebelumnya';
    }
    var fromVanpay = document.referrer && document.referrer.indexOf(location.host) !== -1;
    if (fromVanpay) {
      var backPath = '/';
      try {
        var up = document.createElement('a');
        up.href = document.referrer;
        backPath = up.pathname || '/';
      } catch (_) {}
      if (bLabel) bLabel.textContent = labelFor(backPath);
      bBack.addEventListener('click', function () { history.back(); });
    } else {
      if (bLabel) bLabel.textContent = 'kembali ke Beranda';
      bBack.addEventListener('click', function () { location.href = '/'; });
    }
  }
})();
</script>