<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
:root {
  --bg: #F4F1E8;
  --surface: #FFFFFF;
  --text: #141414;
  --muted: #5F5A4E;
  --line: #141414;
  --brand: #2563EB;
  --brand2: #FF4D00;
  --acc: #FFC700;
  --ok: #16A34A;
  --warn: #D97706;
  --bad: #DC2626;
  --r: 10px;
  --bw: 2px;
  --shadow: 4px 4px 0 #141414;
  --grad: linear-gradient(105deg, #FFC700 0%, #FF4D00 75%);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  font-family: "Space Grotesk", "Inter", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.55;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
h1, h2, h3, .v, .amount, .brand b { font-family: "Space Grotesk", "Inter", system-ui, sans-serif; }
a { color: var(--brand); text-decoration: none; }
a, button { -webkit-tap-highlight-color: transparent; }
::selection { background: var(--acc); color: #141414; }
.wrap { width: min(1120px, 94%); margin: 0 auto; }

/* ---------- brand ---------- */
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 20px; color: var(--text); }
.brand img, .brand svg { height: 34px; width: auto; }
.brand b { background: var(--acc); padding: 2px 8px; border: var(--bw) solid var(--line); box-shadow: 3px 3px 0 var(--line); transform: rotate(-1deg); }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  border: var(--bw) solid var(--line); cursor: pointer; font: inherit; font-weight: 700;
  border-radius: var(--r); padding: 10px 18px; box-shadow: 3px 3px 0 var(--line);
  transition: transform .06s ease, box-shadow .06s ease, background .15s ease;
}
.btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--line); }
.btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--line); }
.btn.grad { background: var(--grad); color: #fff; }
.btn.primary { background: var(--acc); color: #141414; }
.btn.ghost { background: #fff; color: #141414; }
.btn.ghost:hover { background: #FFE48F; }
.btn.danger { background: #fff; color: var(--bad); }
.btn.danger:hover { background: #FEE2E2; }
.btn.green { background: var(--ok); color: #fff; }
.btn:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: 3px 3px 0 var(--line); }

/* ---------- landing ---------- */
.hero { padding: 96px 0 62px; background: var(--bg); border-bottom: var(--bw) solid var(--line); }
.hero h1 { font-size: clamp(30px, 4.8vw, 54px); line-height: 1.06; letter-spacing: -1px; max-width: 760px; font-weight: 700; }
.hero h1 em { font-style: normal; background: var(--acc); border: var(--bw) solid var(--line); box-shadow: 4px 4px 0 var(--line); padding: 1px 10px; margin: 0 2px; }
.hero p.sub { color: var(--text); font-size: 17px; max-width: 620px; margin: 20px 0 30px; font-weight: 500; }
.hero .cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }

.features, .how { padding: 96px 0 58px; }
.features h2, .how h2 { font-size: 26px; letter-spacing: -.6px; margin-bottom: 26px; display: inline-block; background: var(--acc); border: var(--bw) solid var(--line); box-shadow: 4px 4px 0 var(--line); padding: 4px 14px; transform: rotate(-1deg); }
.grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 20px; }
.grid3 .card:nth-child(3n+2) { transform: rotate(.5deg); }
.grid3 .card:nth-child(3n) { transform: rotate(-.4deg); }
.card { background: var(--surface); border: var(--bw) solid var(--line); border-radius: var(--r); padding: 20px; box-shadow: var(--shadow); }
.card .ic { width: 42px; height: 42px; border: var(--bw) solid var(--line); background: var(--acc); color: var(--text); display: grid; place-items: center; font-size: 19px; margin-bottom: 14px; }
.card h3 { font-size: 16px; margin-bottom: 6px; }
.card p { color: var(--muted); font-size: 14px; }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px; counter-reset: st; }
.step { position: relative; background: var(--surface); border: var(--bw) solid var(--line); border-radius: var(--r); padding: 22px 20px 20px 58px; box-shadow: var(--shadow); }
.step::before { counter-increment: st; content: counter(st, decimal-leading-zero); position: absolute; left: 16px; top: 18px; width: 30px; height: 30px; display: grid; place-items: center; font-weight: 700; background: var(--brand2); color: #fff; border: var(--bw) solid var(--line); }
.step b { display: block; margin-bottom: 4px; }
.step span { color: var(--muted); font-size: 14px; }

.cta2 { background: var(--acc); border: var(--bw) solid var(--line); border-radius: var(--r); box-shadow: 6px 6px 0 var(--line); color: var(--text); padding: 44px 34px; text-align: center; margin: 16px 0 64px; }
.cta2 h2 { font-size: 28px; margin-bottom: 8px; letter-spacing: -.6px; }
.cta2 p { opacity: .85; margin-bottom: 22px; }
.cta2 .btn { background: #141414; color: #fff; }

footer { background: #141414; color: #BDB6A6; margin-top: auto; border-top: var(--bw) solid var(--line); }
footer .wrap { padding: 28px 0; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: 13px; }
footer b { color: #fff; }
footer a { color: var(--acc); font-weight: 600; }
footer a:hover { color: #fff; }
code { background: #EFEADF; border: 1px solid #C9C2AE; padding: 1px 5px; border-radius: 4px; font-size: 12.5px; }

/* ---------- auth pages ---------- */
.auth-wrap { min-height: 100vh; display: grid; place-items: center; padding: 96px 16px 48px; }
.auth-card { background: var(--surface); border: var(--bw) solid var(--line); border-radius: var(--r); box-shadow: 6px 6px 0 var(--line); width: min(420px, 100%); padding: 36px 32px; }
.auth-card h1 { font-size: 24px; margin-bottom: 6px; letter-spacing: -.6px; }
.auth-card .sub { color: var(--muted); font-size: 14px; margin-bottom: 24px; font-weight: 500; }
.oauth { display: grid; gap: 14px; }
.oauth .btn { width: 100%; background: #fff; border: var(--bw) solid var(--line); color: var(--text); font-weight: 700; justify-content: flex-start; box-shadow: 3px 3px 0 var(--line); }
.oauth .btn:hover { background: #F0ECFF; }
.oauth .btn svg, .oauth .btn i { width: 20px; height: 20px; margin-right: 6px; font-size: 20px; }
.note { background: #FFF6D8; border: var(--bw) dashed var(--line); border-radius: var(--r); padding: 14px; font-size: 13px; color: var(--text); margin-top: 20px; box-shadow: 3px 3px 0 var(--line); }

/* ---------- dashboard layout ---------- */
.dash main { padding: 76px 26px 26px; min-width: 0; background: var(--bg); width: 100%; max-width: 1020px; margin: 0 auto; }

/* ---------- floating menu / hamburger ---------- */
.fab {
  position: fixed; width: 48px; height: 48px; border: var(--bw) solid var(--line); border-radius: 12px;
  background: var(--acc); color: var(--text); box-shadow: 3px 3px 0 var(--line); cursor: pointer;
  display: grid; place-items: center; font-size: 18px; z-index: 70; transition: transform .06s ease, box-shadow .06s ease;
}
.fab:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--line); }
.fab:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--line); }
.fab-burger { top: 12px; right: 12px; }
.fab-back { top: 12px; left: 12px; background: #fff; }
.fab-x { position: static; background: #fff; width: 40px; height: 40px; flex-shrink: 0; }
.scrim { display: none; position: fixed; inset: 0; background: rgba(20, 20, 20, .55); z-index: 80; }
.scrim.on { display: block; }
.drawer {
  position: fixed; top: 0; right: 0; bottom: 0; width: min(300px, 88vw); z-index: 90;
  background: #141414; color: #E9E4D8; display: flex; flex-direction: column;
  transform: translateX(100%); transition: transform .22s ease; border-left: var(--bw) solid var(--line);
}
.drawer.open { transform: translateX(0); box-shadow: -6px 0 0 rgba(20, 20, 20, .3); }
.drawer-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 14px 12px; border-bottom: var(--bw) solid #3A3529; }
.drawer-top .brand { color: #fff; }
.drawer-body { flex: 1; overflow-y: auto; padding: 14px 10px; }
.drawer-foot { border-top: var(--bw) solid #3A3529; padding: 12px; display: grid; gap: 6px; }
.drawer-nav { display: grid; gap: 4px; }
.drawer-nav a, .drawer-link {
  display: flex; align-items: center; gap: 11px; color: #D5CFC0; font-size: 14px; font-weight: 600;
  padding: 11px 12px; border-radius: 8px; text-decoration: none;
}
.drawer-nav a i { width: 18px; text-align: center; font-size: 15px; }
.drawer-nav a:hover, .drawer-link:hover { background: #211F1A; color: #fff; }
.drawer-nav a.on { background: var(--acc); color: #141414; box-shadow: 3px 3px 0 #000; }
.drawer-link.danger { color: #FCA5A5; }
.drawer-link.danger:hover { background: #3B1118; color: #fff; }
.drawer .prof { display: flex; gap: 11px; align-items: center; padding: 12px 4px; margin-bottom: 10px; border-bottom: var(--bw) solid #3A3529; }
.drawer .prof img { width: 40px; height: 40px; border: var(--bw) solid var(--acc); box-shadow: 2px 2px 0 var(--acc); }
.drawer .prof b { display: block; font-size: 14px; color: #fff; }
.drawer .prof span { font-size: 12px; color: #A79E8D; }

/* ---------- sections / widgets ---------- */
.page h2 { font-size: 22px; letter-spacing: -.5px; margin-bottom: 18px; font-weight: 700; }
.grid { display: grid; gap: 18px; }
.g4 { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
.g2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
.card .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
.card .v { font-size: 28px; font-weight: 700; margin-top: 5px; letter-spacing: -.8px; }
.card .v small { font-size: 13px; color: var(--muted); font-weight: 600; }
.card .hov { font-size: 13px; color: var(--muted); margin-top: 7px; }
.badge { display: inline-block; padding: 3px 10px; border: var(--bw) solid var(--line); font-size: 11px; font-weight: 700; letter-spacing: .3px; box-shadow: 2px 2px 0 var(--line); }
.badge.PENDING, .badge.pending { background: #FACC15; color: #141414; }
.badge.PAID, .badge.paid { background: #22C55E; color: #141414; }
.badge.DONE, .badge.done { background: #22C55E; color: #141414; }
.badge.EXPIRED, .badge.expired { background: #F97316; color: #fff; }
.badge.REJECTED, .badge.rejected { background: #EF4444; color: #fff; }
.badge.owner { background: #6366F1; color: #fff; }
.badge.user { background: #D6D0C0; color: #141414; }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th, td { text-align: left; padding: 12px 12px; border-bottom: var(--bw) solid var(--line); white-space: nowrap; }
th { color: #141414; font-size: 11px; text-transform: uppercase; letter-spacing: .8px; background: var(--acc); font-weight: 700; }
tr:hover td { background: #FFF6D8; }
.empty { color: var(--muted); text-align: center; padding: 36px 0; font-size: 14px; font-weight: 500; }

form .row { margin-bottom: 16px; }
label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; }
input, select, textarea { width: 100%; font: inherit; padding: 11px 12px; border: var(--bw) solid var(--line); border-radius: 8px; background: #fff; color: var(--text); }
input:focus, select:focus, textarea:focus { outline: 3px solid var(--acc); border-color: var(--line); }
.inline { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

.pay-box { display: grid; grid-template-columns: auto 1fr; gap: 26px; align-items: center; background: #fff; border: var(--bw) solid var(--line); border-radius: var(--r); padding: 24px; box-shadow: var(--shadow); }
.pay-box img { width: 220px; height: 220px; border: var(--bw) solid var(--line); box-shadow: 5px 5px 0 var(--line); }
.pay-info .amount { font-size: 32px; font-weight: 700; letter-spacing: -.8px; }
.pay-info .to { color: var(--muted); font-size: 13px; margin: 2px 0 14px; }
.pay-info .rowm { display: flex; justify-content: space-between; padding: 9px 0; border-top: var(--bw) dashed #CFC8B6; font-size: 14px; font-weight: 500; }
.pay-info .rowm b { font-variant-numeric: tabular-nums; }
.count { font-weight: 700; font-size: 18px; }

.chart-bars { display: flex; align-items: flex-end; gap: 10px; height: 160px; padding-top: 12px; }
.chart-bars .bar { flex: 1; min-height: 4px; position: relative; border: var(--bw) solid var(--line); opacity: 1; }
.chart-bars .bar:nth-child(3n+1) { background: var(--acc); }
.chart-bars .bar:nth-child(3n+2) { background: var(--brand); }
.chart-bars .bar:nth-child(3n) { background: var(--brand2); }
.chart-bars .bar span { position: absolute; bottom: -24px; left: 0; right: 0; text-align: center; font-size: 10.5px; color: var(--muted); font-weight: 600; }

.msg { display: none; margin-top: 14px; padding: 12px 14px; border: var(--bw) solid var(--line); font-size: 13.5px; font-weight: 600; }
.msg.err { display: block; background: #FEE2E2; color: #991B1B; }
.msg.ok { display: block; background: #DCFCE7; color: #14532D; }

.rowm { display: flex; justify-content: space-between; padding: 8px 0; border-top: var(--bw) dashed #CFC8B6; font-size: 14px; font-weight: 500; }
.rowm b { font-variant-numeric: tabular-nums; }
.rowlr { display: flex; gap: 10px; align-items: center; justify-content: space-between; }
.rowlr > .btn { margin: 0; }
.cwrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; }
.cwrap .card { margin: 0; }
.cwrap label { margin-top: 14px; }
.cwrap .k { margin-bottom: 8px; }
.hint { font-size: 12.5px; color: var(--muted); font-weight: 500; margin: 10px 0 4px; line-height: 1.6; }
.hint b { color: var(--text); }
.sep { display: flex; align-items: center; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; margin: 16px 0 4px; font-weight: 700; }
.sep::before, .sep::after { content: ''; flex: 1; border-top: var(--bw) dashed #CFC8B6; margin: 0 10px; }
.cwrap textarea { resize: vertical; }
.cwrap input[type=number] { font-variant-numeric: tabular-nums; }

.steps-status li { padding: 9px 0; font-size: 14px; color: var(--muted); font-weight: 500; }
.steps-status li.on { color: var(--ok); font-weight: 700; }

/* ---------- mobile ---------- */
@media (max-width: 640px) {
  .fab-burger, .fab-back { top: 10px; }
  .brand { font-size: 17px; }
  .brand img { height: 28px; }
  .dash main { padding: 74px 12px 16px; }
  .g4 { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .g2 { grid-template-columns: 1fr; }
  .card { padding: 16px; }
  .card .v { font-size: 22px; }
  .pay-box { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 16px; padding: 20px 16px; }
  .pay-box img { width: 180px; height: 180px; }
  .pay-info .amount { font-size: 26px; }
  .cwrap { grid-template-columns: 1fr; }
  .rowlr { flex-direction: column; align-items: stretch; }
  .rowlr > .btn, .rowlr .inline { width: 100%; justify-content: center; }
  .btn { min-height: 44px; }
  input, select, textarea { min-height: 46px; }
  .auth-card { padding: 28px 20px; }
  .hero { padding: 84px 0 34px; }
  .hero p.sub { font-size: 15px; }
  .hero .cta { flex-direction: column; align-items: stretch; }
  .hero .cta .btn { width: 100%; }
  .cta2 { padding: 34px 20px; }
  footer .wrap { flex-direction: column; text-align: center; }
}
</style>