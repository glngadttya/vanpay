<!doctype html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Dokumentasi API — VanPay Gateway' }) %>
</head>
<body>
  <%- include('partials/menu', { body: include('partials/pubnav', { navNow: 'docs' }), foot: '' }) %>
  <main style="padding:12px 0 10px">
    <div class="wrap">
      <h2>Dokumentasi API</h2>
      <p class="hint" style="font-size:15px;color:var(--muted)">REST API VanPay Gateway. Base URL akses dibatasi per server — verifikasi nilai aktual melalui panel hosting Anda.</p>

      <div class="card" style="margin-top:16px">
        <div class="rowm"><span>Base URL (contoh)</span><b>https://payment.savantlabs.my.id</b></div>
        <div class="rowm"><span>Format respons</span><b>{ "ok": true, "data": ... }</b></div>
        <div class="rowm"><span>Format error</span><b>{ "ok": false, "error": "..." }</b></div>
        <div class="rowm"><span>Status QRIS</span><b>PENDING · PAID · EXPIRED · REJECTED</b></div>
      </div>

      <div class="sep"><span>Umum</span></div>
      <div class="card">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Metode</th><th>Endpoint</th><th>Deskripsi</th></tr></thead>
            <tbody>
              <tr><td><span class="badge" style="background:#D6D0C0">GET</span></td><td><code>/health</code></td><td>Cek kondisi server (uptime)</td></tr>
            </tbody>
          </table>
        </div>
        <p class="hint">Contoh:</p>
        <div class="term">
          <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">health.sh</span></div>
<pre><span class="c-prompt">$</span> curl https://payment.savantlabs.my.id/health
<span class="c-com"># respon sukses (HTTP 200)</span>
{ <span class="c-k">"ok"</span>: <span class="c-b">true</span>, <span class="c-k">"name"</span>: <span class="c-s">"vanpay"</span>, <span class="c-k">"uptime"</span>: <span class="c-n">482</span> }</pre>
        </div>
      </div>

      <div class="sep"><span>Status pembayaran (publik — tanpa login)</span></div>
      <div class="card">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Metode</th><th>Endpoint</th><th>Deskripsi</th></tr></thead>
            <tbody>
              <tr><td><span class="badge" style="background:#D6D0C0">GET</span></td><td><code>/api/qris/:id/status</code></td><td>Status QRIS: PENDING, PAID, EXPIRED, atau REJECTED</td></tr>
            </tbody>
          </table>
        </div>
        <p class="hint">Contoh:</p>
        <div class="term">
          <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">status.sh</span></div>
<pre><span class="c-prompt">$</span> curl https://payment.savantlabs.my.id/api/qris/PN-MU6B0C1Q2AA897/status
<span class="c-com"># respon sukses (HTTP 200)</span>
{ <span class="c-k">"ok"</span>: <span class="c-b">true</span>, <span class="c-k">"data"</span>: { <span class="c-k">"status"</span>: <span class="c-s">"PAID"</span>, <span class="c-k">"paidAt"</span>: <span class="c-s">"2026-09-18T02:11:14.754Z"</span> } }</pre>
        </div>
      </div>

      <div class="sep"><span>User (sesi login dashboard)</span></div>
      <div class="card">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Metode</th><th>Endpoint</th><th>Deskripsi</th></tr></thead>
            <tbody>
              <tr><td><span class="badge" style="background:#FACC15;color:#141414">POST</span></td><td><code>/api/qris/create</code></td><td>Buat QRIS baru. Body: <code>{ amount, note? }</code></td></tr>
              <tr><td><span class="badge" style="background:#FACC15;color:#141414">POST</span></td><td><code>/api/withdraw</code></td><td>Ajukan penarikan. Body: <code>{ amount, method, accountNumber, accountName }</code></td></tr>
              <tr><td><span class="badge" style="background:#4ECDC4">GET</span></td><td><code>/api/bal</code></td><td>Saldo aktif</td></tr>
              <tr><td><span class="badge" style="background:#4ECDC4">GET</span></td><td><code>/api/payments</code></td><td>Riwayat QRIS pengguna (50 terakhir)</td></tr>
              <tr><td><span class="badge" style="background:#4ECDC4">GET</span></td><td><code>/api/ledger</code></td><td>Mutasi saldo (100 terakhir)</td></tr>
              <tr><td><span class="badge" style="background:#4ECDC4">GET</span></td><td><code>/api/withdraws</code></td><td>Riwayat penarikan pengguna</td></tr>
              <tr><td><span class="badge" style="background:#4ECDC4">GET</span></td><td><code>/api/stats</code></td><td>Statistik real-time pengguna</td></tr>
            </tbody>
          </table>
        </div>
        <p class="hint">Otorisasi: seluruh endpoint di atas memerlukan cookie sesi dari login Google/GitHub. Autentikasi API programatik (token) belum tersedia.</p>
        <p class="hint">Contoh buat QRIS:</p>
        <div class="term">
          <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">create-qris.sh</span></div>
<pre><span class="c-prompt">$</span> curl -X POST https://payment.savantlabs.my.id/api/qris/create \
  -H <span class="c-s">"Cookie: vanpay=&lt;session&gt;"</span> \
  -H <span class="c-s">"Content-Type: application/json"</span> \
  -d <span class="c-s">'{"amount": 10000, "note": "Order #123"}'</span>
<span class="c-com"># respon sukses (HTTP 200)</span>
{ <span class="c-k">"ok"</span>: <span class="c-b">true</span>, <span class="c-k">"data"</span>: {
  <span class="c-k">"id"</span>: <span class="c-s">"PN-MU6B0C1Q2AA897"</span>,
  <span class="c-k">"amount"</span>: <span class="c-n">10000</span>,
  <span class="c-k">"fee"</span>: <span class="c-n">70</span>,
  <span class="c-k">"payAmount"</span>: <span class="c-n">10071</span>,
  <span class="c-k">"uniqueCode"</span>: <span class="c-n">1</span>,
  <span class="c-k">"status"</span>: <span class="c-s">"PENDING"</span>,
  <span class="c-k">"note"</span>: <span class="c-s">"Order #123"</span>,
  <span class="c-k">"qrUrl"</span>: <span class="c-s">"/api/qris/PN-MU6B0C1Q2AA897/qr.png"</span>,
  <span class="c-k">"statusUrl"</span>: <span class="c-s">"/api/qris/PN-MU6B0C1Q2AA897/status"</span>
} }</pre>
        </div>
        <p class="hint">Contoh cek saldo:</p>
        <div class="term">
          <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">cek-saldo.sh</span></div>
<pre><span class="c-prompt">$</span> curl -H <span class="c-s">"Cookie: vanpay=&lt;session&gt;"</span> https://payment.savantlabs.my.id/api/bal
<span class="c-com"># respon sukses (HTTP 200)</span>
{ <span class="c-k">"ok"</span>: <span class="c-b">true</span>, <span class="c-k">"data"</span>: { <span class="c-k">"balance"</span>: <span class="c-n">10071</span> } }</pre>
        </div>
      </div>

      <div class="sep"><span>Operasional</span></div>
      <div class="card">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Metode</th><th>Endpoint</th><th>Deskripsi</th></tr></thead>
            <tbody>
              <tr><td><span class="badge" style="background:#D6D0C0">GET/POST</span></td><td><code>/api/cron/poll?secret=&lt;secret&gt;</code></td><td>Paksa siklus polling pembayaran (untuk cron/job scheduler)</td></tr>
            </tbody>
          </table>
        </div>
        <p class="hint">Polling pembayaran juga berjalan otomatis di dalam server. Endpoint cron tersedia untuk mempercepat deteksi jika dibutuhkan.</p>
      </div>

      <div class="card" style="margin:20px 0 8px">
        <p class="hint" style="margin:0"><b>Skema pembayaran QRIS:</b> total dibayar pembeli = nominal + fee (persentase standar) + kode unik 1–99. Saldo yang dikreditkan ke akun Anda adalah nominal penuh.</p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>