<!doctype html>
<html lang="id">
<head>
  <%- include('partials/head', { title: 'Dokumentasi API — VanPay Gateway' }) %>
</head>
<body>
  <%- include('partials/menu', { body: include('partials/pubnav', { navNow: 'docs' }), foot: '' }) %>
<%
  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }

  function jsonHtml(obj) {
    const txt = JSON.stringify(obj, null, 2).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return txt.replace(/("(?:\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*")(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?/g, function (m, str, colon, bool) {
      if (str) return '<span class="c-k">' + str + '</span>' + (colon || '');
      if (bool) return '<span class="c-b">' + bool + '</span>';
      return '<span class="c-n">' + m + '</span>';
    });
  }

  function term(title) {
    return '<div class="term"><div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">' + esc(title) + '</span></div>';
  }
%>
  <main style="padding:12px 0 34px">
    <div class="wrap">
      <h2>Dokumentasi API</h2>
      <p class="hint" style="font-size:15px;color:var(--muted);margin:0 0 2px">REST API VanPay Gateway. Setiap endpoint di bawah terdiri dari dua blok: perintah <b>curl</b> (nama berkas <code>.sh</code>) dan contoh <b>respons JSON</b> (nama berkas <code>.json</code>).</p>
      <p class="hint" style="font-size:15px;color:var(--muted);margin:4px 0 0">Akses endpoint pribadi memakai <b>API Key</b> (dibuat &amp; dicabut lewat <b>Dashboard → Developer Tools</b>), dikirim via header <code>X-API-Key</code> atau <code>Authorization: Bearer</code>.</p>

      <div class="sep"><span>Umum</span></div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">health.sh</span></div>
<pre><span class="c-prompt">$</span> curl https://payment.savantlabs.my.id/health</pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">health.json</span></div>
<pre><%- jsonHtml({ ok: true, name: 'vanpay', uptime: 482 }) %></pre>
      </div>

      <div class="sep"><span>Status pembayaran (publik — tanpa autentikasi)</span></div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">status.sh</span></div>
<pre><span class="c-prompt">$</span> curl https://payment.savantlabs.my.id/api/qris/PN-MU6B0C1Q2AA897/status</pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">status.json</span></div>
<pre><%- jsonHtml({ ok: true, data: { status: 'PAID', paidAt: '2026-09-18T02:12:10.001Z' } }) %></pre>
      </div>
      <p class="hint" style="margin:8px 0 0;font-size:14px;color:var(--muted)">Saat menunggu pembayaran, <code>paidAt</code> bernilai <code>null</code>. Polling otomatis server tetap berjalan; endpoint ini juga memicu siklus polling.</p>

      <div class="sep"><span>QRIS instan</span></div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">create-qris.sh</span></div>
<pre><span class="c-prompt">$</span> curl -X POST https://payment.savantlabs.my.id/api/qris/create \
  -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c11d2e3f4a5b6c7d8e9f10aa1bb2cc3dd4ee5ff6aa7bb8cc9dd0e1"</span> \
  -H <span class="c-s">"Content-Type: application/json"</span> \
  -d <span class="c-s">'{"amount": 10000, "note": "Order #123"}'</span></pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">create-qris.json</span></div>
<pre><%- jsonHtml({ ok: true, data: { id: 'PN-MU6B0C1Q2AA897', amount: 10000, fee: 70, payAmount: 10071, uniqueCode: 1, status: 'PENDING', expiresAt: '2026-09-18T02:26:14.754Z', note: 'Order #123', qrUrl: '/api/qris/PN-MU6B0C1Q2AA897/qr.png', statusUrl: '/api/qris/PN-MU6B0C1Q2AA897/status' } }) %></pre>
      </div>
      <p class="hint" style="margin:8px 0 0;font-size:14px;color:var(--muted)">Unduh gambar QR (PNG) — <code>PN-MU6B0C1Q2AA897</code> contoh ID transaksi:</p>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">download-qr.sh</span></div>
<pre><span class="c-prompt">$</span> curl -o qr.png https://payment.savantlabs.my.id/api/qris/PN-MU6B0C1Q2AA897/qr.png \
  -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c..."</span></pre>
      </div>

      <div class="sep"><span>Saldo &amp; transaksi</span></div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">cek-saldo.sh</span></div>
<pre><span class="c-prompt">$</span> curl -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c1..."</span> https://payment.savantlabs.my.id/api/bal</pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">cek-saldo.json</span></div>
<pre><%- jsonHtml({ ok: true, data: { balance: 1045000 } }) %></pre>
      </div>

      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">riwayat-qris.sh</span></div>
<pre><span class="c-prompt">$</span> curl -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c1..."</span> https://payment.savantlabs.my.id/api/payments</pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">riwayat-qris.json</span></div>
<pre><%- jsonHtml({ ok: true, data: [ { id: 'PN-MU6B0C1Q2AA897', amount: 10000, fee: 70, payAmount: 10071, uniqueCode: 1, status: 'PAID', note: 'Order #123', createdAt: '2026-09-18T02:11:14.754Z', statusUrl: '/api/qris/PN-MU6B0C1Q2AA897/status' } ] }) %></pre>
      </div>

      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">mutasi.sh</span></div>
<pre><span class="c-prompt">$</span> curl -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c1..."</span> https://payment.savantlabs.my.id/api/ledger</pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">mutasi.json</span></div>
<pre><%- jsonHtml({ ok: true, data: { items: [ { id: 31, type: 'deposit', amount: 10000, createdAt: '2026-09-18T02:12:10.001Z', ref: 'PN-MU6B0C1Q2AA897' } ], total: 100000 } }) %></pre>
      </div>

      <div class="sep"><span>Penarikan dana</span></div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">tarik-dana.sh</span></div>
<pre><span class="c-prompt">$</span> curl -X POST https://payment.savantlabs.my.id/api/withdraw \
  -H <span class="c-s">"X-API-Key: vk_ee172f0ba0c1..."</span> \
  -H <span class="c-s">"Content-Type: application/json"</span> \
  -d <span class="c-s">'{"amount": 5000, "method": "DANA", "accountNumber": "081234567890", "accountName": "Ari"}'</span></pre>
      </div>
      <div class="term">
        <div class="term-top"><i class="r"></i><i class="y"></i><i class="g"></i><span class="t-title">tarik-dana.json</span></div>
<pre><%- jsonHtml({ ok: true, data: { id: 'WD-MU6B0D3K2F9A88', amount: 5000, method: 'DANA', accountNumber: '081234567890', accountName: 'Ari', status: 'PENDING', requestedAt: '2026-09-18T03:00:00.000Z' } }) %></pre>
      </div>

      <p class="hint" style="margin:14px 0 0;font-size:14px;color:var(--muted)">Skema QRIS: total dibayar pembeli = <code>nominal + fee + kode unik 1–99</code>. Saldo yang dikreditkan ke akun Anda adalah nominal penuh.</p>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
