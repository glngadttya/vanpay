<div class="o-dash">
  <div class="o-bar">
    <div>
      <div class="bread"><a href="/dashboard/o-overview">Owner</a> / Pengaturan</div>
      <h2>Pengaturan platform</h2>
      <div class="sub">QRIS induk, biaya, OAuth, bot Telegram, dan scanner GoBiz.</div>
    </div>
  </div>

  <% if (msg) { %><div class="msg ok" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-check"></i>&nbsp;<%= esc(msg) %></div><% } %>
  <% if (err) { %><div class="msg err" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-exclamation"></i>&nbsp;<%= esc(err) %></div><% } %>

  <div class="o-card">
    <div class="o-card-h">
      <div class="o-k"><i class="fa-solid fa-server"></i>Status layanan</div>
      <span class="o-hint" style="margin:0">terakhir polling: <%= s.sys.lastPollAt ? fmt(s.sys.lastPollAt) : '—' %></span>
    </div>
    <div class="o-rows">
      <div class="o-row"><span>QRIS utama</span><b><%- s.qr.qris_string ? badge('DONE') : badge('PENDING') %></b></div>
      <div class="o-row"><span>Mode QR</span><b><%= esc(s.qr.mode) %></b></div>
      <div class="o-row"><span>GoBiz</span><b><%- s.gobiz.linked ? badge('DONE') : badge('PENDING') %></b></div>
      <div class="o-row"><span>Merchant</span><b><%= esc(s.gobiz.merchantName || s.gobiz.merchantId || '—') %></b></div>
      <div class="o-row"><span>Telegram</span><b><%- s.tg.bot_token ? badge('DONE') : badge('PENDING') %></b></div>
      <div class="o-row"><span>Login web</span><b><%= s.oauth.github_client_id || s.oauth.google_client_id ? 'Aktif' : 'Hanya /bootstrap' %></b></div>
      <div class="o-row"><span>Polling</span><b class="o-mut" style="font-size:12px"><%= esc(s.sys.lastPollMsg || '—') %></b></div>
    </div>
  </div>

  <form class="o-card" id="fQris" data-settings>
    <div class="o-card-h"><div class="o-k"><i class="fa-solid fa-qrcode"></i>QRIS utama &amp; mode</div></div>
    <label><span>Mode QR</span>
      <select name="qr.mode">
        <option value="dynamic" <%= s.qr.mode === 'dynamic' ? 'selected' : '' %>>Dinamis (nominal + kode unik otomatis)</option>
        <option value="static" <%= s.qr.mode === 'static' ? 'selected' : '' %>>Statis (QR induk, nominal dipilih pengguna)</option>
      </select>
    </label>
    <label><span>String QRIS statis</span>
      <textarea name="qr.qris_string" rows="4" placeholder="Tempel string 000201010211266... (bukan kode QR anda)"><%= esc(s.qr.qris_string) %></textarea>
    </label>
    <p class="o-hint">Scan QRIS statis anda dengan aplikasi scan apa pun → salin isinya (mulai <b>000201</b>…). Mode dinamis menyisipkan nominal + kode unik otomatis; mode statis menampilkan QR induk untuk nominal besar.</p>
    <button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Simpan QRIS</button>
    <div class="msg" id="msgFQris"></div>
  </form>

  <form class="o-card" id="fBilling" data-settings>
    <div class="o-card-h"><div class="o-k"><i class="fa-solid fa-money-bill-wave"></i>Biaya &amp; limit</div></div>
    <div class="o-grid2">
      <label><span>Fee deposit (%)</span><input name="billing.fee_pct" type="number" step="0.1" min="0" value="<%= s.billing.fee_pct %>"></label>
      <label><span>Fee minimum (Rp)</span><input name="billing.min_fee" type="number" min="0" value="<%= s.billing.min_fee %>"></label>
      <label><span>Min QRIS</span><input name="billing.min_qris" type="number" min="0" value="<%= s.billing.min_qris %>"></label>
      <label><span>Max QRIS</span><input name="billing.max_qris" type="number" min="0" value="<%= s.billing.max_qris %>"></label>
      <label><span>Min penarikan</span><input name="billing.min_wd" type="number" min="0" value="<%= s.billing.min_wd %>"></label>
      <label><span>Max penarikan</span><input name="billing.max_wd" type="number" min="0" value="<%= s.billing.max_wd %>"></label>
    </div>
    <button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Simpan biaya</button>
    <div class="msg" id="msgFBilling"></div>
  </form>

  <form class="o-card" id="fOauth" data-settings>
    <div class="o-card-h"><div class="o-k"><i class="fa-solid fa-lock"></i>Login web (Google/GitHub)</div></div>
    <div class="o-grid2">
      <label><span>GitHub Client ID</span><input name="oauth.github_client_id" value="<%= esc(s.oauth.github_client_id) %>"></label>
      <label><span>GitHub Client Secret</span><input name="oauth.github_client_secret" type="password" placeholder="Kosongkan jika tidak diubah" autocomplete="new-password"></label>
      <label><span>Google Client ID</span><input name="oauth.google_client_id" value="<%= esc(s.oauth.google_client_id) %>"></label>
      <label><span>Google Client Secret</span><input name="oauth.google_client_secret" type="password" placeholder="Kosongkan jika tidak diubah" autocomplete="new-password"></label>
    </div>
    <label><span>Email owner</span><input name="oauth.owner_email" value="<%= esc(s.oauth.owner_email) %>"></label>
    <p class="o-hint">Callback: <b><%= esc(origin) %>/auth/github/callback</b> &middot; <b><%= esc(origin) %>/auth/google/callback</b></p>
    <button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Simpan OAuth</button>
    <div class="msg" id="msgFOauth"></div>
  </form>

  <form class="o-card" id="fTg" data-settings>
    <div class="o-card-h"><div class="o-k"><i class="fa-solid fa-paper-plane"></i>Telegram notifikasi</div></div>
    <label><span>Bot token</span><input name="tg.bot_token" type="password" placeholder="123456:ABC..." autocomplete="new-password"></label>
    <label><span>Chat / channel ID</span><input name="tg.chat_id" value="<%= esc(s.tg.chat_id) %>"></label>
    <div class="o-toolbar">
      <button class="btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i>&nbsp;Simpan Telegram</button>
      <button class="btn" type="button" data-tgtest="1"><i class="fa-solid fa-paper-plane"></i>&nbsp;Kirim pesan uji</button>
    </div>
    <div class="msg" id="msgFTg"></div>
  </form>

  <div class="o-card" id="gobizCard">
    <div class="o-card-h"><div class="o-k"><i class="fa-solid fa-mobile-screen-button"></i>GoBiz (scanner otomatis)</div></div>
    <% if (s.gobiz.linked) { %>
      <div class="o-rows">
        <div class="o-row"><span>Merchant</span><b><%= esc(s.gobiz.merchantName || s.gobiz.merchantId || '—') %></b></div>
        <div class="o-row"><span>Nomor</span><b><%= esc(s.gobiz.phone || '—') %></b></div>
        <div class="o-row"><span>Sesi</span><b><%- s.gobiz.hasRefreshToken ? badge('DONE') : badge('PENDING') %></b></div>
      </div>
      <div class="o-toolbar">
        <button class="btn" type="button" data-gobiz="refresh"><i class="fa-solid fa-rotate"></i>&nbsp;Perbarui token</button>
        <button class="btn danger" type="button" data-gobiz="logout"><i class="fa-solid fa-right-from-bracket"></i>&nbsp;Logout GoBiz</button>
      </div>
    <% } else { %>
      <label><span>Nomor (OTP)</span>
        <input name="gobiz.phone" placeholder="81234567890">
      </label>
      <div class="o-toolbar">
        <button class="btn" type="button" data-gobiz="otp"><i class="fa-solid fa-envelope"></i>&nbsp;Kirim OTP</button>
      </div>
      <label><span>Kode OTP</span><input name="gobiz.otp" placeholder="123456"></label>
      <button class="btn primary" type="button" data-gobiz="verify"><i class="fa-solid fa-check"></i>&nbsp;Verifikasi</button>
      <div class="o-sep"><span>atau</span></div>
      <div class="o-grid2">
        <label><span>Email GoBiz</span><input name="gobiz.email" placeholder="email@merchant.id"></label>
        <label><span>Password</span><input name="gobiz.password" type="password" placeholder="••••••••"></label>
      </div>
      <button class="btn primary" type="button" data-gobiz="password"><i class="fa-solid fa-right-to-bracket"></i>&nbsp;Login password</button>
    <% } %>
    <p class="o-hint">Login minimal sekali agar polling otomatis berjalan. Token disimpan terenkripsi; cabut kapan saja.</p>
    <div class="msg" id="msgGobiz"></div>
  </div>
</div>
