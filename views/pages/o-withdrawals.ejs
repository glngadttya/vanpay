<div class="o-dash">
  <div class="o-bar">
    <div>
      <div class="bread"><a href="/dashboard/o-overview">Owner</a> / Penarikan</div>
      <h2>Penarikan user</h2>
      <div class="sub">Setujui atau tolak permintaan tarik dana user.</div>
    </div>
    <span class="o-pill <%= pending.length ? 'warn' : 'ok' %>" style="margin:0"><i class="fa-solid fa-hourglass-half"></i>&nbsp;<%= pending.length %> menunggu</span>
  </div>

  <% if (msg) { %><div class="msg ok" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-check"></i>&nbsp;<%= esc(msg) %></div><% } %>
  <% if (err) { %><div class="msg err" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-exclamation"></i>&nbsp;<%= esc(err) %></div><% } %>

  <div class="o-card">
    <div class="o-card-h">
      <div class="o-k"><i class="fa-solid fa-hourglass-half"></i>Menunggu proses (<%= pending.length %>)</div>
      <span class="o-hint" style="margin:0">Verifikasi akun sebelum menyetujui.</span>
    </div>
    <div class="o-tbl-wrap">
      <table class="o-tbl">
        <thead><tr><th>ID</th><th>User</th><th>Nominal</th><th>Metode</th><th>Akun</th><th>Aksi</th></tr></thead>
        <tbody>
          <% if (pending.length) { %>
            <% pending.forEach((w) => { %>
              <tr>
                <td><b><%= esc(w.id) %></b></td>
                <td><%= w.user ? esc(w.user.name || w.user.email) : '#' + w.user_id %></td>
                <td><b><%= rupiah(w.amount) %></b></td>
                <td><%= esc(w.method) %></td>
                <td><%= esc(w.accountName || '') %> <span class="o-mut"><%= esc(w.accountNumber || '') %></span></td>
                <td>
                  <button class="btn ok sm" data-wd="<%= esc(w.id) %>" data-act="approve"><i class="fa-solid fa-check"></i>&nbsp;Setujui</button>
                  <button class="btn danger sm" data-wd="<%= esc(w.id) %>" data-act="reject"><i class="fa-solid fa-xmark"></i>&nbsp;Tolak</button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="o-empty">Tidak ada permintaan pending.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="o-card">
    <div class="o-card-h">
      <div class="o-k"><i class="fa-solid fa-clock-rotate-left"></i>Riwayat semua</div>
      <span class="o-hint" style="margin:0"><%= all.length %> transaksi</span>
    </div>
    <div class="o-toolbar">
      <a class="o-chip <%= !filter ? 'on' : '' %>" href="/dashboard/o-withdrawals"><i class="fa-solid fa-list"></i>Semua</a>
      <% ['PENDING', 'DONE', 'REJECTED'].forEach((s) => { %>
        <a class="o-chip <%= filter === s ? 'on' : '' %>" href="/dashboard/o-withdrawals?status=<%= s %>"><%= s %></a>
      <% }) %>
    </div>
    <div class="o-tbl-wrap">
      <table class="o-tbl">
        <thead><tr><th>ID</th><th>User</th><th>Nominal</th><th>Metode</th><th>Status</th><th>Catatan</th><th>Waktu</th></tr></thead>
        <tbody>
          <% if (all.length) { %>
            <% all.forEach((w) => { %>
              <tr>
                <td><b><%= esc(w.id) %></b></td>
                <td><%= w.user ? esc(w.user.name || w.user.email) : '#' + w.user_id %></td>
                <td><b><%= rupiah(w.amount) %></b></td>
                <td><%= esc(w.method) %></td>
                <td><%- badge(w.status) %></td>
                <td><span class="o-mut"><%= esc(w.adminNote || '—') %></span></td>
                <td><span class="o-mut"><%= fmt(w.requestedAt) %></span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" class="o-empty">Belum ada riwayat.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
