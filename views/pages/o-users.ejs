<div class="o-dash">
  <div class="o-bar">
    <div>
      <div class="bread"><a href="/dashboard/o-overview">Owner</a> / Pengguna</div>
      <h2>Pengguna platform</h2>
      <div class="sub">Daftar lengkap akun dan posisi saldo masing-masing.</div>
    </div>
    <a class="btn primary" href="/dashboard/o-overview"><i class="fa-solid fa-chart-simple"></i>&nbsp;Lihat ringkasan</a>
  </div>

  <% if (msg) { %><div class="msg ok" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-check"></i>&nbsp;<%= esc(msg) %></div><% } %>
  <% if (err) { %><div class="msg err" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-exclamation"></i>&nbsp;<%= esc(err) %></div><% } %>

  <div class="o-card">
    <div class="o-card-h">
      <div class="o-k"><i class="fa-solid fa-users"></i>Semua pengguna</div>
      <span class="o-hint" style="margin:0"><%= list.length %> akun</span>
    </div>
    <div class="o-toolbar">
      <div class="o-chips">
        <a class="o-chip <%= !filter ? 'on' : '' %>" href="/dashboard/o-users"><i class="fa-solid fa-list"></i>Semua</a>
        <a class="o-chip <%= filter === 'OWNER' ? 'on' : '' %>" href="/dashboard/o-users?role=OWNER"><i class="fa-solid fa-crown"></i>Owner</a>
      </div>
      <span class="o-hint" style="margin:0;margin-left:auto"><i class="fa-solid fa-filter"></i>&nbsp;<%= esc(filter || 'semua') %></span>
    </div>
    <div class="o-card-b" style="padding:0;overflow-x:auto">
      <table class="o-tbl">
        <thead>
          <tr><th>Akun</th><th>Email</th><th>Peran</th><th>Saldo</th><th>Total deposit</th><th>Total tarik</th><th>Menunggu</th><th>Bergabung</th></tr>
        </thead>
        <tbody>
          <% if (list.length) { %>
            <% list.forEach((u) => { %>
              <tr>
                <td>
                  <div class="u">
                    <% if (u.avatar) { %><img src="<%= esc(u.avatar) %>" alt=""><% } else { %><span class="ava"><%= esc((u.name || u.email || '?').slice(0, 1).toUpperCase()) %></span><% } %>
                    <div><b><%= esc(u.name || '—') %></b><span><%= esc(u.role) %></span></div>
                  </div>
                </td>
                <td><%= esc(u.email) %></td>
                <td><%- badge(u.role) %></td>
                <td class="amt"><%= rupiah(u.balance) %></td>
                <td class="amt"><%= rupiah(u.totalDeposit) %></td>
                <td class="amt"><%= rupiah(u.totalWithdraw) %></td>
                <td><%= u.pendingWithdraw || 0 %></td>
                <td><span class="o-hint" style="margin:0"><%= fmt(u.createdAt) %></span></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="8" class="o-empty">Belum ada pengguna terdaftar.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
