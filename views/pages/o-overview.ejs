<div class="o-dash">
  <div class="o-bar">
    <div>
      <div class="bread"><a href="/dashboard/o-overview">Owner</a> / Ringkasan</div>
      <h2>Ringkasan platform</h2>
      <div class="sub">Pantau performa gateway secara ringkas dalam satu layar.</div>
    </div>
    <a class="btn primary" href="/dashboard/o-users"><i class="fa-solid fa-users"></i>&nbsp;Kelola pengguna</a>
  </div>

  <% if (msg) { %><div class="msg ok" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-check"></i>&nbsp;<%= esc(msg) %></div><% } %>
  <% if (err) { %><div class="msg err" id="flashMsg" data-auto="1"><i class="fa-solid fa-circle-exclamation"></i>&nbsp;<%= esc(err) %></div><% } %>

  <div class="o-stats">
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-users"></i>Pengguna</div>
      <div class="val"><%= stats.users %></div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-chart-line"></i>Volume deposit</div>
      <div class="val"><%= rupiah(stats.volume) %></div>
      <div class="trend up"><i class="fa-solid fa-arrow-trend-up"></i>&nbsp;<%= stats.successCount %> sukses</div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-coins"></i>Fee terkumpul</div>
      <div class="val"><%= rupiah(stats.feesEarned) %></div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-wallet"></i>Saldo keluar</div>
      <div class="val"><%= rupiah(stats.totalBalance) %></div>
      <div class="trend">tersebar ke user</div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-clock-rotate-left"></i>Transaksi</div>
      <div class="val"><%= stats.successCount %><small>&nbsp;sukses</small></div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-percent"></i>Tingkat sukses</div>
      <div class="val"><%= stats.successRate %>%</div>
      <div class="trend">dari <%= stats.payments %> transaksi</div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-hourglass-half"></i>QRIS pending</div>
      <div class="val"><%= stats.pendingPayments %></div>
    </div>
    <div class="o-stat">
      <div class="lbl"><i class="fa-solid fa-hand-holding-dollar"></i>Tarik pending</div>
      <div class="val"><%= rupiah(stats.pendingWithdrawSum) %></div>
      <div class="trend"><%= stats.pendingWithdraw %> permintaan</div>
    </div>
  </div>

  <div class="o-card">
    <div class="o-card-h">
      <div class="o-k"><i class="fa-solid fa-chart-simple"></i>Volume deposit 14 hari terakhir</div>
      <span class="o-hint" style="margin:0"><%= rupiah(stats.volume) %> total</span>
    </div>
    <div class="o-card-b"><%- chartBars(stats.daily) %></div>
  </div>
</div>
